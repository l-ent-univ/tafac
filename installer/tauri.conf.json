{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Installer Tafac",
  "mainBinaryName": "Tafac-setup",
  "version": "0.0.0",
  "identifier": "fr.tafac.installer",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Installer Tafac",
        "width": 480,
        "height": 360,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "transparent": true,
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": {
    "active": false,
    "icon": ["../src-tauri/icons/installer.ico", "../src-tauri/icons/128x128.png"]
  }
}
