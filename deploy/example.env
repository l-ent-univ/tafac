# Required: generate with `openssl rand -base64 32` (44 characters).
SESSION_SECRET=

# The image serves every university (MULTI_UNIVERSITY=1, the picker at login,
# like tafac.fr). UNIVERSITY is then the default one: for the demo account
# from the neutral page and for old per-university hostnames that match none.
UNIVERSITY=univ-rennes
# One university only (no picker): uncomment and set UNIVERSITY above.
#MULTI_UNIVERSITY=0
# Universities served (comma-separated ids), default: all.
#UNIVERSITIES=univ-rennes,univ-exemple

# Optional: anonymous audience measurement (docs/ANALYTICS.md).
#POSTHOG_PROJECT_KEY=
# POSTHOG_HOST can also be your own proxy (p.example.fr, see Caddyfile).
#POSTHOG_HOST=https://eu.i.posthog.com
# ENT accounts whose events are never sent (the instance's developers).
#ANALYTICS_EXCLUDED_USERS=

# Optional: the desktop app's access to passwords saved for this domain,
# served at /.well-known/apple-app-site-association.
#APPLE_APP_IDS=<team id>.fr.tafac.desktop
