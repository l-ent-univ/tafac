<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- French: what macOS adds to the menus itself (Fenêtre's tabs, the
	     full screen item, Services) and its dialogs follow the app's
	     language. Tauri merges this into the bundle's Info.plist. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>fr</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>fr</string>
	</array>
</dict>
</plist>
