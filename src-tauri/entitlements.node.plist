<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The bundled Node (the local server), signed on its own by
     scripts/desktop-sign.mjs: only what V8 needs to compile JavaScript.
     The app's restricted entitlements (associated domains) would get it
     killed at launch: a helper has no provisioning profile of its own. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
