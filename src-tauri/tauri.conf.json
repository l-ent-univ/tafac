{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tafac",
  "version": "0.1.0",
  "identifier": "fr.tafac.desktop",
  "build": {
    "frontendDist": "placeholder",
    "beforeDevCommand": { "script": "npm run build", "wait": true }
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
