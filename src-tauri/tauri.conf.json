{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tafac",
  "version": "0.0.0",
  "identifier": "fr.tafac.desktop",
  "build": {
    "frontendDist": "placeholder",
    "beforeDevCommand": { "script": "npm run build", "wait": true }
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "background": "dmg/background.tiff",
        "windowSize": { "width": 660, "height": 428 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/installer.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "languages": ["French"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://tafac.fr/desktop/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA4NTFEMDBGM0RDMTA4MEUKUldRT0NNRTlEOUJSQ0VXRUJwdkJlVEh3eFVLT05mLy94VlJlKzVtVTlDMEtqSTQ2Tks4VTEybjIK",
      "requireSignedVersion": true
    }
  }
}
