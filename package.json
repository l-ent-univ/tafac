{
  "name": "tafac",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node server.js",
    "build": "vite build && node --disable-warning=ExperimentalWarning scripts/prerender-landing.mjs",
    "build:all": "npm run build",
    "lint": "eslint .",
    "icons": "node scripts/build-icon-bundle.mjs",
    "test": "node --test tests/*.test.js tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "desktop:dev": "tauri dev",
    "desktop:prepare": "node scripts/desktop-prepare.mjs",
    "desktop:build": "tauri build --config src-tauri/tauri.bundle.conf.json",
    "desktop:build:signed": "tauri build --config src-tauri/tauri.bundle.conf.json --config src-tauri/tauri.signed.conf.json --bundles app && node scripts/desktop-sign.mjs",
    "desktop:dmg": "node scripts/desktop-dmg.mjs",
    "tauri": "tauri",
    "ios:prepare": "node scripts/ios-prepare.mjs",
    "ios:dev": "npm run ios:prepare && tauri ios dev",
    "ios:build": "npm run ios:prepare && tauri ios build"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@lisse/core": "0.7.3",
    "@tailwindcss/vite": "^4.2.2",
    "@tiptap/extension-highlight": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "posthog-node": "^5.55.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanitize-html": "^2.18.1",
    "skullet": "0.0.3",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@formatjs/intl-datetimeformat": "^8.0.3",
    "@formatjs/intl-getcanonicallocales": "^3.3.1",
    "@formatjs/intl-locale": "^5.4.3",
    "@formatjs/intl-numberformat": "^10.0.4",
    "@formatjs/intl-pluralrules": "^7.0.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "acorn": "^8.19.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "node-fetch": "^3.3.2",
    "regexpu-core": "^6.5.4",
    "typescript": "^7.0.2",
    "unorm": "^1.6.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0"
  }
}
